# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and must never be committed.

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5433/fund_transfer_db
DB_USERNAME=banking_admin
DB_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka
EUREKA_URL=http://localhost:8761/eureka

# Saga on (true) or off (false)
TRANSFER_SAGA_ENABLED=true

# Direct service URLs - only used when the saga is off
CBS_SERVICE_URL=http://localhost:8084
ACCOUNT_SERVICE_URL=http://localhost:8081
CHARGE_FEE_SERVICE_URL=http://localhost:8085
OTP_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087

# Address that receives the transfer result e-mails
TRANSFER_NOTIFY_EMAIL=change-me@example.com
